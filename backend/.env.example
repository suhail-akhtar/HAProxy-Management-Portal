PORT=5555
NODE_ENV=development
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# HAProxy Mode
# - mock: Use in-memory mock data only (for demo/development)
# - hybrid: Use mock data as fallback when HAProxy APIs unavailable (default)
# - real: Require HAProxy APIs (fail if not available)
HAPROXY_MODE=hybrid

# HAProxy Runtime API (Stats Socket)
HAPROXY_SOCKET_PATH=/var/run/haproxy/admin.sock
HAPROXY_SOCKET_TIMEOUT=5000

# HAProxy Data Plane API
# Install from: https://github.com/haproxytech/dataplaneapi
HAPROXY_DATAPLANE_URL=http://localhost:5555/v2
HAPROXY_DATAPLANE_USER=admin
HAPROXY_DATAPLANE_PASS=adminpwd

# HAProxy Configuration
HAPROXY_CONFIG_PATH=/etc/haproxy/haproxy.cfg
HAPROXY_BACKUP_DIR=./backups/config

# CORS Settings
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
